<div class="top-row navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Школа</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Главная
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="students">
                Ученики
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="classes">
                Классы
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="subjects">
                Предметы
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="grades">
                Журнал оценок
            </NavLink>
        </div>
    </nav>
</div>

<div class="nav-account">
    <AuthorizeView>
        <Authorized>
            <div class="nav-account-info">
                <span>@context.User.Identity?.Name</span>
                <span class="nav-account-role">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
            </div>
            <form method="post" action="/Account/Logout">
                <button class="btn-link-action" type="submit">Выйти</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <NavLink class="nav-link" href="login">Войти</NavLink>
            <NavLink class="nav-link" href="register">Регистрация</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>