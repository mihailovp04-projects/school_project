@page "/classes"
@attribute [Authorize]
@inherits CrudPage<SchoolClass>
@inject ISchoolClassService SchoolClassService
@inject ISubjectService SubjectService

<div class="page-header">
    <h1>Классы</h1>
</div>

<div class="toolbar">
    @if (!IsFormVisible)
    {
        <button class="btn-primary" @onclick="ShowAddForm">Добавить класс</button>
    }
</div>

@if (!string.IsNullOrEmpty(PageMessage))
{
    <p class="form-error">@PageMessage</p>
}

@if (IsFormVisible)
{
    <EntityFormCard TItem="SchoolClass"
                    Title="@(EditingId == null ? "Новый класс" : "Редактирование класса")"
                    Model="FormModel"
                    OnSave="HandleSave"
                    OnCancel="CloseForm"
                    ErrorMessage="@FormError"
                    FormName="ClassForm">
        <div class="form-group">
            <label>Название класса</label>
            <InputText @bind-Value="FormModel.Name" placeholder="Например, 5-А" />
        </div>
    </EntityFormCard>
}

@if (assigningClass != null)
{
    <div class="card">
        <p class="section-title">Предметы класса «@assigningClass.Name»</p>

        @if (assigningClass.Subjects.Count > 0)
        {
            <ul class="plain-list">
                @foreach (var subject in assigningClass.Subjects)
                {
                    <li>
                        @subject.Name
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <button class="btn-link-action danger" @onclick="() => HandleRemoveSubject(subject.Id)">Убрать</button>
                            </Authorized>
                        </AuthorizeView>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="muted">Предметы ещё не привязаны.</p>
        }

        <div class="assign-subject-row">
            <select @bind="selectedSubjectId">
                <option value="0">-- выберите предмет --</option>
                @foreach (var subject in GetUnassignedSubjects(assigningClass))
                {
                    <option value="@subject.Id">@subject.Name</option>
                }
            </select>
            <button class="btn-secondary" @onclick="HandleAssignSubject">Привязать</button>
            <button class="btn-secondary" @onclick="CloseAssignForm">Закрыть</button>
        </div>
    </div>
}

@if (schoolClasses == null)
{
    <p class="muted">Загрузка...</p>
}
else if (schoolClasses.Count == 0)
{
    <div class="empty-state">Классов пока нет.</div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Учеников в классе</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var schoolClass in schoolClasses)
                {
                    <tr>
                        <td>@schoolClass.Name</td>
                        <td>@schoolClass.Students.Count</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-link-action" @onclick="() => ToggleDetails(schoolClass.Id)">
                                    @(expandedClassId == schoolClass.Id ? "Скрыть" : "Состав")
                                </button>
                                <button class="btn-link-action" @onclick="() => OpenAssignForm(schoolClass)">Предметы</button>
                                <button class="btn-link-action" @onclick="() => ShowEditForm(schoolClass)">Изменить</button>
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <button class="btn-link-action danger" @onclick="() => HandleDelete(schoolClass.Id)">Удалить</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>

                    @if (expandedClassId == schoolClass.Id)
                    {
                        <tr>
                            <td colspan="3">
                                <div class="class-details">
                                    <div class="class-details-column">
                                        <p class="section-title">Ученики класса</p>
                                        @if (schoolClass.Students.Count == 0)
                                        {
                                            <p class="muted">В классе пока нет учеников.</p>
                                        }
                                        else
                                        {
                                            <ul class="plain-list">
                                                @foreach (var student in schoolClass.Students)
                                                {
                                                    <li>@student.LastName @student.FirstName</li>
                                                }
                                            </ul>
                                        }
                                    </div>

                                    <div class="class-details-column">
                                        <p class="section-title">Предметы класса</p>
                                        @if (schoolClass.Subjects.Count == 0)
                                        {
                                            <p class="muted">Предметы ещё не привязаны.</p>
                                        }
                                        else
                                        {
                                            <ul class="plain-list">
                                                @foreach (var subject in schoolClass.Subjects)
                                                {
                                                    <li>@subject.Name</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<SchoolClass>? schoolClasses;
    private List<Subject> subjects = new();
    private SchoolClass? assigningClass;
    private int? expandedClassId;
    private int selectedSubjectId;

    protected override async Task OnInitializedAsync()
    {
        subjects = await SubjectService.GetAllAsync();
        await ReloadClassesAsync();
    }

    private async Task ReloadClassesAsync()
    {
        schoolClasses = await SchoolClassService.GetAllAsync();

        if (assigningClass != null)
        {
            var currentId = assigningClass.Id;
            assigningClass = schoolClasses.FirstOrDefault(c => c.Id == currentId);
        }
    }

    private void ShowAddForm()
    {
        OpenForm(new SchoolClass(), null);
    }

    private void ShowEditForm(SchoolClass schoolClass)
    {
        OpenForm(new SchoolClass { Id = schoolClass.Id, Name = schoolClass.Name }, schoolClass.Id);
    }

    private Task HandleSave()
    {
        return SaveFormAsync(EditingId == null ? "AddClass" : "UpdateClass", SaveClassAsync, ReloadClassesAsync);
    }

    private async Task<bool> SaveClassAsync()
    {
        if (EditingId == null)
        {
            await SchoolClassService.AddAsync(FormModel);
            return true;
        }

        return await SchoolClassService.UpdateAsync(FormModel);
    }

    private Task HandleDelete(int id)
    {
        return RunAdminActionAsync("Удалить этот класс?", "DeleteClass", id, () => SchoolClassService.DeleteAsync(id), ReloadClassesAsync);
    }

    private void ToggleDetails(int classId)
    {
        expandedClassId = expandedClassId == classId ? null : classId;
    }

    private void OpenAssignForm(SchoolClass schoolClass)
    {
        assigningClass = schoolClass;
        selectedSubjectId = 0;
        PageMessage = null;
    }

    private void CloseAssignForm()
    {
        assigningClass = null;
    }

    private IEnumerable<Subject> GetUnassignedSubjects(SchoolClass schoolClass)
    {
        var assignedIds = schoolClass.Subjects.Select(s => s.Id).ToHashSet();
        return subjects.Where(s => !assignedIds.Contains(s.Id));
    }

    private async Task HandleAssignSubject()
    {
        if (selectedSubjectId == 0 || assigningClass == null)
        {
            return;
        }

        var classId = assigningClass.Id;
        var subjectId = selectedSubjectId;
        await RunPageActionAsync("AssignSubject", classId, () => SchoolClassService.AssignSubjectAsync(classId, subjectId), ReloadClassesAsync);
        selectedSubjectId = 0;
    }

    private Task HandleRemoveSubject(int subjectId)
    {
        if (assigningClass == null)
        {
            return Task.CompletedTask;
        }

        var classId = assigningClass.Id;
        return RunAdminActionAsync("Отвязать этот предмет?", "RemoveSubject", classId, () => SchoolClassService.RemoveSubjectAsync(classId, subjectId), ReloadClassesAsync);
    }
}
