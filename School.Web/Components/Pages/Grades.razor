@page "/grades"
@attribute [Authorize]
@inject IGradeService GradeService
@inject IStudentService StudentService
@inject AdminGuard AdminGuard

<div class="page-header">
    <h1>Журнал оценок</h1>
</div>

<div class="selector-row">
    <label>Ученик:</label>
    <select @bind="selectedStudentId" @bind:after="LoadStudentGrades">
        <option value="0">-- выберите ученика --</option>
        @if (students != null)
        {
            @foreach (var student in students)
            {
                <option value="@student.Id">@student.LastName @student.FirstName</option>
            }
        }
    </select>
</div>

@if (selectedStudentId != 0 && selectedStudent != null)
{
    @if (overallAverage.HasValue)
    {
        <div class="stat-card stat-card-overall">
            <div>
                <div class="stat-value">
                    @overallAverage.Value.ToString("F2") <span class="stat-scale">/ 10</span>
                </div>
                <div class="stat-label">Общий средний балл</div>
            </div>
        </div>
    }

    @if (subjectAverages != null && subjectAverages.Count > 0)
    {
        <div class="subject-averages">
            @foreach (var item in subjectAverages)
            {
                <div class="stat-card">
                    <div>
                        <div class="stat-value">
                            @item.Average.ToString("F2") <span class="stat-scale">/ 10</span>
                        </div>
                        <div class="stat-label">@item.SubjectName</div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="toolbar">
        @if (!showForm)
        {
            @if (selectedStudent.SchoolClass.Subjects.Count > 0)
            {
                <button class="btn-primary" @onclick="ShowAddForm">Добавить оценку</button>
            }
            else
            {
                <p class="muted">К классу ученика ещё не привязан ни один предмет.</p>
            }
        }
    </div>

    @if (showForm)
    {
        <EntityFormCard TItem="Grade"
                         Title="@(editingId == null ? "Новая оценка" : "Редактирование оценки")"
                         Model="formModel"
                         OnSave="HandleSave"
                         OnCancel="CancelForm"
                         ErrorMessage="@errorMessage"
                         FormName="GradeForm">
            <div class="form-group">
                <label>Предмет</label>
                <select @bind="formModel.SubjectId">
                    <option value="0">-- выберите предмет --</option>
                    @foreach (var subject in selectedStudent.SchoolClass.Subjects)
                    {
                        <option value="@subject.Id">@subject.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Оценка (1-10)</label>
                <InputNumber @bind-Value="formModel.Value" />
            </div>

            <div class="form-group">
                <label>Дата</label>
                <InputDate @bind-Value="formModel.Date" />
            </div>
        </EntityFormCard>
    }

    <p class="section-title">История оценок</p>

    <div class="selector-row">
        <label>С:</label>
        <input type="date" @bind="filterFrom" />
        <label>По:</label>
        <input type="date" @bind="filterTo" />
        @if (filterFrom != null || filterTo != null)
        {
            <button class="btn-link-action" @onclick="ClearPeriodFilter">Сбросить период</button>
        }
    </div>

    @if (studentGrades == null)
    {
        <p class="muted">Загрузка...</p>
    }
    else if (studentGrades.Count == 0)
    {
        <div class="empty-state">У этого ученика пока нет оценок.</div>
    }
    else
    {
        var filteredGrades = GetFilteredGrades();

        if (filteredGrades.Count == 0)
        {
            <div class="empty-state">Нет оценок за выбранный период.</div>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Предмет</th>
                            <th>Оценка</th>
                            <th>Дата</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grade in filteredGrades)
                        {
                            <tr>
                                <td>@grade.Subject.Name</td>
                                <td>@GetGradeBadge(grade.Value)</td>
                                <td>@grade.Date.ToShortDateString()</td>
                                <td>
                                    <div class="table-actions">
                                        <button class="btn-link-action" @onclick="() => ShowEditForm(grade)">Изменить</button>
                                        <AuthorizeView Roles="Admin">
                                            <Authorized>
                                                <button class="btn-link-action danger" @onclick="() => HandleDelete(grade.Id)">Удалить</button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    private List<Student>? students;
    private Student? selectedStudent;
    private List<Grade>? studentGrades;
    private List<SubjectAverage>? subjectAverages;
    private double? overallAverage;
    private Grade formModel = new() { Date = DateTime.Now };
    private int? editingId;
    private int selectedStudentId = 0;
    private bool showForm = false;
    private string? errorMessage;
    private DateTime? filterFrom;
    private DateTime? filterTo;

    private class SubjectAverage
    {
        public string SubjectName { get; set; } = string.Empty;
        public double Average { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        students = await StudentService.GetAllAsync();
    }

    private async Task LoadStudentGrades()
    {
        showForm = false;
        errorMessage = null;
        filterFrom = null;
        filterTo = null;

        if (selectedStudentId == 0)
        {
            selectedStudent = null;
            studentGrades = null;
            subjectAverages = null;
            overallAverage = null;
            return;
        }

        selectedStudent = await StudentService.GetByIdAsync(selectedStudentId);
        studentGrades = await GradeService.GetByStudentIdAsync(selectedStudentId);
        overallAverage = await GradeService.GetAverageGradeAsync(selectedStudentId);
        CalculateSubjectAverages();
    }

    private List<Grade> GetFilteredGrades()
    {
        if (studentGrades == null)
        {
            return new List<Grade>();
        }

        var result = studentGrades.AsEnumerable();

        if (filterFrom.HasValue)
        {
            result = result.Where(g => g.Date.Date >= filterFrom.Value.Date);
        }

        if (filterTo.HasValue)
        {
            result = result.Where(g => g.Date.Date <= filterTo.Value.Date);
        }

        return result.OrderByDescending(g => g.Date).ToList();
    }

    private void ClearPeriodFilter()
    {
        filterFrom = null;
        filterTo = null;
    }

    private void CalculateSubjectAverages()
    {
        if (studentGrades == null)
        {
            subjectAverages = null;
            return;
        }

        subjectAverages = studentGrades
            .GroupBy(g => g.Subject.Name)
            .Select(group => new SubjectAverage
            {
                SubjectName = group.Key,
                Average = group.Average(g => g.Value)
            })
            .OrderBy(a => a.SubjectName)
            .ToList();
    }

    private void ShowAddForm()
    {
        formModel = new() { Date = DateTime.Now };
        editingId = null;
        showForm = true;
        errorMessage = null;
    }

    private void ShowEditForm(Grade grade)
    {
        formModel = new Grade
        {
            Id = grade.Id,
            Value = grade.Value,
            Date = grade.Date,
            SubjectId = grade.SubjectId,
            StudentId = grade.StudentId
        };
        editingId = grade.Id;
        showForm = true;
        errorMessage = null;
    }

    private void CancelForm()
    {
        showForm = false;
        errorMessage = null;
    }

    private async Task HandleSave()
    {
        formModel.StudentId = selectedStudentId;

        try
        {
            if (editingId == null)
            {
                await GradeService.AddAsync(formModel);
            }
            else
            {
                formModel.Id = editingId.Value;
                await GradeService.UpdateAsync(formModel);
            }

            studentGrades = await GradeService.GetByStudentIdAsync(selectedStudentId);
            overallAverage = await GradeService.GetAverageGradeAsync(selectedStudentId);
            CalculateSubjectAverages();
            showForm = false;
            errorMessage = null;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = "Что-то пошло не так, попробуйте ещё раз.";
        }
    }

    private async Task HandleDelete(int id)
    {
        var result = await AdminGuard.ConfirmAdminActionAsync("Удалить эту оценку?");
        if (result == null)
        {
            errorMessage = "У вас нет прав для удаления.";
            return;
        }
        if (result != true)
        {
            return;
        }

        await GradeService.DeleteAsync(id);
        studentGrades = await GradeService.GetByStudentIdAsync(selectedStudentId);
        overallAverage = await GradeService.GetAverageGradeAsync(selectedStudentId);
        CalculateSubjectAverages();
    }

    private RenderFragment GetGradeBadge(int value) => builder =>
    {
        var cssClass = value <= 4 ? "low" : value <= 7 ? "mid" : "high";
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"grade-badge {cssClass}");
        builder.AddContent(2, value);
        builder.CloseElement();
    };
}