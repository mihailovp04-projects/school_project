@page "/register"
@attribute [AllowAnonymous]

<div class="page-header">
    <h1>Регистрация</h1>
</div>

<div class="card card-narrow">
    <form method="post" action="/Account/Register">
        <AntiforgeryToken />
        <div class="form">
            <div class="form-group">
                <label>Логин</label>
                <input type="text" name="login" required maxlength="256" />
            </div>

            <div class="form-group">
                <label>Пароль</label>
                <input type="password" name="password" required minlength="8" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">Зарегистрироваться</button>
            </div>
        </div>
    </form>

    @if (ErrorText != null)
    {
        <p class="form-error">@ErrorText</p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? ErrorText => Error switch
    {
        "1" => "Не удалось завершить регистрацию. Попробуйте другой логин.",
        "2" => "Пароль должен быть не короче 8 символов.",
        "3" => "Логин обязателен и не должен быть длиннее 256 символов.",
        _ => null
    };
}
