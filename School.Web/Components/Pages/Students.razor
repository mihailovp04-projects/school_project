@page "/students"
@attribute [Authorize]
@inject IStudentService StudentService
@inject ISchoolClassService SchoolClassService
@inject AdminGuard AdminGuard

<div class="page-header">
    <h1>Ученики</h1>
</div>

<div class="selector-row">
    <label>Класс:</label>
    <select @bind="filterClassId" @bind:after="ApplyFilter">
        <option value="0">Все классы</option>
        @if (schoolClasses != null)
        {
            @foreach (var schoolClass in schoolClasses)
            {
                <option value="@schoolClass.Id">@schoolClass.Name</option>
            }
        }
    </select>

    <label>Фамилия:</label>
    <input type="text" @bind="filterLastName" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Начните вводить фамилию" />
</div>

<div class="toolbar">
    @if (!showForm)
    {
        <button class="btn-primary" @onclick="ShowAddForm">Добавить ученика</button>
    }
</div>

@if (!string.IsNullOrEmpty(pageMessage))
{
    <p class="form-error">@pageMessage</p>
}

@if (showForm)
{
    <EntityFormCard TItem="Student"
                     Title="@(editingId == null ? "Новый ученик" : "Редактирование ученика")"
                     Model="formModel"
                     OnSave="HandleSave"
                     OnCancel="CancelForm"
                     ErrorMessage="@errorMessage"
                     FormName="StudentForm">
        <div class="form-group">
            <label>Имя</label>
            <InputText @bind-Value="formModel.FirstName" />
        </div>

        <div class="form-group">
            <label>Фамилия</label>
            <InputText @bind-Value="formModel.LastName" />
        </div>

        <div class="form-group">
            <label>Дата рождения</label>
            <InputDate @bind-Value="formModel.BirthDate" />
        </div>

        <div class="form-group">
            <label>Телефон</label>
            <InputText @bind-Value="formModel.Phone" placeholder="+37369123456" />
        </div>

        <div class="form-group">
            <label>Класс</label>
            <select @bind="formModel.SchoolClassId">
                <option value="0">-- выберите класс --</option>
                @if (schoolClasses != null)
                {
                    @foreach (var schoolClass in schoolClasses)
                    {
                        <option value="@schoolClass.Id">@schoolClass.Name</option>
                    }
                }
            </select>
        </div>
    </EntityFormCard>
}

@if (students == null)
{
    <p class="muted">Загрузка...</p>
}
else
{
    if (filteredStudents.Count == 0)
    {
        <div class="empty-state">Ничего не найдено.</div>
    }
    else
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Фамилия</th>
                        <th>Имя</th>
                        <th>Класс</th>
                        <th>Дата рождения</th>
                        <th>Телефон</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in filteredStudents)
                    {
                        <tr>
                            <td>@student.LastName</td>
                            <td>@student.FirstName</td>
                            <td>@student.SchoolClass.Name</td>
                            <td>@student.BirthDate.ToShortDateString()</td>
                            <td>@student.Phone</td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn-link-action" @onclick="() => ShowEditForm(student)">Изменить</button>
                                    <AuthorizeView Roles="Admin">
                                        <Authorized>
                                            <button class="btn-link-action danger" @onclick="() => HandleDelete(student.Id)">Удалить</button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const string NotFoundMessage = "Запись не найдена: возможно, её уже удалил другой пользователь. Список обновлён.";

    private List<Student>? students;
    private List<Student> filteredStudents = new();
    private List<SchoolClass>? schoolClasses;
    private Student formModel = new();
    private int? editingId;
    private int filterClassId = 0;
    private string filterLastName = string.Empty;
    private bool showForm = false;
    private string? errorMessage;
    private string? pageMessage;

    protected override async Task OnInitializedAsync()
    {
        schoolClasses = await SchoolClassService.GetAllAsync();
        await ReloadStudentsAsync();
    }

    private async Task ReloadStudentsAsync()
    {
        students = await StudentService.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (students == null)
        {
            filteredStudents = new List<Student>();
            return;
        }

        var result = students.AsEnumerable();

        if (filterClassId != 0)
        {
            result = result.Where(s => s.SchoolClassId == filterClassId);
        }

        if (!string.IsNullOrWhiteSpace(filterLastName))
        {
            result = result.Where(s => s.LastName.Contains(filterLastName, StringComparison.OrdinalIgnoreCase));
        }

        filteredStudents = result.ToList();
    }

    private void ShowAddForm()
    {
        formModel = new();
        editingId = null;
        showForm = true;
        errorMessage = null;
        pageMessage = null;
    }

    private void ShowEditForm(Student student)
    {
        formModel = new Student
        {
            Id = student.Id,
            FirstName = student.FirstName,
            LastName = student.LastName,
            BirthDate = student.BirthDate,
            Phone = student.Phone,
            SchoolClassId = student.SchoolClassId
        };
        editingId = student.Id;
        showForm = true;
        errorMessage = null;
        pageMessage = null;
    }

    private void CancelForm()
    {
        showForm = false;
        errorMessage = null;
    }

    private async Task HandleSave()
    {
        try
        {
            var saved = true;

            if (editingId == null)
            {
                await StudentService.AddAsync(formModel);
            }
            else
            {
                formModel.Id = editingId.Value;
                saved = await StudentService.UpdateAsync(formModel);
            }

            await ReloadStudentsAsync();
            showForm = false;
            errorMessage = null;
            pageMessage = saved ? null : NotFoundMessage;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = "Что-то пошло не так, попробуйте ещё раз.";
        }
    }

    private async Task HandleDelete(int id)
    {
        pageMessage = null;

        var result = await AdminGuard.ConfirmAdminActionAsync("Удалить этого ученика?");
        if (result == null)
        {
            pageMessage = "У вас нет прав для удаления.";
            return;
        }
        if (result != true)
        {
            return;
        }

        try
        {
            var deleted = await StudentService.DeleteAsync(id);
            await ReloadStudentsAsync();
            if (!deleted)
            {
                pageMessage = NotFoundMessage;
            }
        }
        catch (ArgumentException ex)
        {
            pageMessage = ex.Message;
        }
        catch (Exception)
        {
            pageMessage = "Что-то пошло не так, попробуйте ещё раз.";
        }
    }
}