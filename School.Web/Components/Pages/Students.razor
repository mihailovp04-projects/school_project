@page "/students"
@attribute [Authorize]
@inherits CrudPage<Student>
@inject IStudentService StudentService
@inject ISchoolClassService SchoolClassService

<div class="page-header">
    <h1>Ученики</h1>
</div>

<div class="selector-row">
    <label>Класс:</label>
    <select @bind="filterClassId" @bind:after="ApplyFilterAsync">
        <option value="0">Все классы</option>
        @if (schoolClasses != null)
        {
            @foreach (var schoolClass in schoolClasses)
            {
                <option value="@schoolClass.Id">@schoolClass.Name</option>
            }
        }
    </select>

    <label>Фамилия:</label>
    <input type="text" @bind="filterLastName" @bind:event="oninput" @bind:after="ApplyFilterAsync" placeholder="Начните вводить фамилию" />
</div>

<div class="toolbar">
    @if (!IsFormVisible)
    {
        <button class="btn-primary" @onclick="ShowAddForm">Добавить ученика</button>
    }
</div>

@if (!string.IsNullOrEmpty(PageMessage))
{
    <p class="form-error">@PageMessage</p>
}

@if (IsFormVisible)
{
    <EntityFormCard TItem="Student"
                    Title="@(EditingId == null ? "Новый ученик" : "Редактирование ученика")"
                    Model="FormModel"
                    OnSave="HandleSave"
                    OnCancel="CloseForm"
                    ErrorMessage="@FormError"
                    FormName="StudentForm">
        <div class="form-group">
            <label>Имя</label>
            <InputText @bind-Value="FormModel.FirstName" />
        </div>

        <div class="form-group">
            <label>Фамилия</label>
            <InputText @bind-Value="FormModel.LastName" />
        </div>

        <div class="form-group">
            <label>Дата рождения</label>
            <InputDate @bind-Value="FormModel.BirthDate" />
        </div>

        <div class="form-group">
            <label>Телефон</label>
            <InputText @bind-Value="FormModel.Phone" placeholder="+37369123456" />
        </div>

        <div class="form-group">
            <label>Класс</label>
            <select @bind="FormModel.SchoolClassId">
                <option value="0">-- выберите класс --</option>
                @if (schoolClasses != null)
                {
                    @foreach (var schoolClass in schoolClasses)
                    {
                        <option value="@schoolClass.Id">@schoolClass.Name</option>
                    }
                }
            </select>
        </div>
    </EntityFormCard>
}

@if (studentsPage == null)
{
    <p class="muted">Загрузка...</p>
}
else if (studentsPage.TotalCount == 0)
{
    <div class="empty-state">Ничего не найдено.</div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Фамилия</th>
                    <th>Имя</th>
                    <th>Класс</th>
                    <th>Дата рождения</th>
                    <th>Телефон</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in studentsPage.Items)
                {
                    <tr>
                        <td>@student.LastName</td>
                        <td>@student.FirstName</td>
                        <td>@student.SchoolClass.Name</td>
                        <td>@student.BirthDate.ToShortDateString()</td>
                        <td>@student.Phone</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-link-action" @onclick="() => ShowEditForm(student)">Изменить</button>
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <button class="btn-link-action danger" @onclick="() => HandleDelete(student.Id)">Удалить</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pager">
        <button class="btn-secondary" disabled="@(studentsPage.Page <= 1)" @onclick="() => GoToPageAsync(studentsPage.Page - 1)">‹ Назад</button>
        <span class="muted">Страница @studentsPage.Page из @studentsPage.TotalPages · всего учеников: @studentsPage.TotalCount</span>
        <button class="btn-secondary" disabled="@(studentsPage.Page >= studentsPage.TotalPages)" @onclick="() => GoToPageAsync(studentsPage.Page + 1)">Вперёд ›</button>
    </div>
}

@code {
    private const int PageSize = 20;

    private PagedResult<Student>? studentsPage;
    private List<SchoolClass>? schoolClasses;
    private int filterClassId;
    private string filterLastName = string.Empty;
    private int currentPage = 1;
    private int loadVersion;

    protected override async Task OnInitializedAsync()
    {
        schoolClasses = (await SchoolClassService.GetAllAsync()).OrderBy(c => c.Name).ToList();
        await ReloadStudentsAsync();
    }

    private async Task ReloadStudentsAsync()
    {
        var version = ++loadVersion;
        var filter = new StudentFilter
        {
            SchoolClassId = filterClassId == 0 ? null : filterClassId,
            LastName = filterLastName
        };

        var result = await StudentService.GetPagedAsync(filter, currentPage, PageSize);
        if (version != loadVersion)
        {
            return;
        }

        studentsPage = result;
        currentPage = result.Page;
    }

    private Task ApplyFilterAsync()
    {
        currentPage = 1;
        return ReloadAsync(ReloadStudentsAsync);
    }

    private Task GoToPageAsync(int page)
    {
        currentPage = page;
        return ReloadAsync(ReloadStudentsAsync);
    }

    private void ShowAddForm()
    {
        OpenForm(new Student(), null);
    }

    private void ShowEditForm(Student student)
    {
        OpenForm(new Student
        {
            Id = student.Id,
            FirstName = student.FirstName,
            LastName = student.LastName,
            BirthDate = student.BirthDate,
            Phone = student.Phone,
            SchoolClassId = student.SchoolClassId
        }, student.Id);
    }

    private Task HandleSave()
    {
        return SaveFormAsync(EditingId == null ? "AddStudent" : "UpdateStudent", SaveStudentAsync, ReloadStudentsAsync);
    }

    private async Task<bool> SaveStudentAsync()
    {
        if (EditingId == null)
        {
            await StudentService.AddAsync(FormModel);
            return true;
        }

        return await StudentService.UpdateAsync(FormModel);
    }

    private Task HandleDelete(int id)
    {
        return RunAdminActionAsync("Удалить этого ученика?", "DeleteStudent", id, () => StudentService.DeleteAsync(id), ReloadStudentsAsync);
    }
}
