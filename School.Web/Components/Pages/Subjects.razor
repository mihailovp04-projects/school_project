@page "/subjects"
@attribute [Authorize]
@inject ISubjectService SubjectService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider

<div class="page-header">
    <h1>Предметы</h1>
</div>

<div class="toolbar">
    @if (!showForm)
    {
        <button class="btn-primary" @onclick="ShowAddForm">Добавить предмет</button>
    }
</div>

@if (showForm)
{
    <div class="card">
        <p class="section-title">@(editingId == null ? "Новый предмет" : "Редактирование предмета")</p>

        <EditForm Model="formModel" OnValidSubmit="HandleSave" FormName="SubjectForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form">
                <div class="form-group">
                    <label>Название предмета</label>
                    <InputText @bind-Value="formModel.Name" placeholder="Например, Математика" />
                </div>

                <div class="form-actions" style="display: flex; gap: 0.75rem;">
                    <button type="submit" class="btn-primary">Сохранить</button>
                    <button type="button" class="btn-secondary" @onclick="CancelForm">Отменить</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="form-error">@errorMessage</p>
            }
        </EditForm>
    </div>
}

@if (subjects == null)
{
    <p class="muted">Загрузка...</p>
}
else if (subjects.Count == 0)
{
    <div class="empty-state">Предметов пока нет.</div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subject in subjects)
                {
                    <tr>
                        <td>@subject.Name</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-link-action" @onclick="() => ShowEditForm(subject)">Изменить</button>
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <button class="btn-link-action danger" @onclick="() => HandleDelete(subject.Id)">Удалить</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Subject>? subjects;
    private Subject formModel = new();
    private int? editingId;
    private bool showForm = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        subjects = await SubjectService.GetAllAsync();
    }

    private void ShowAddForm()
    {
        formModel = new();
        editingId = null;
        showForm = true;
        errorMessage = null;
    }

    private void ShowEditForm(Subject subject)
    {
        formModel = new Subject { Id = subject.Id, Name = subject.Name };
        editingId = subject.Id;
        showForm = true;
        errorMessage = null;
    }

    private void CancelForm()
    {
        showForm = false;
        errorMessage = null;
    }

    private async Task HandleSave()
    {
        try
        {
            if (editingId == null)
            {
                await SubjectService.AddAsync(formModel);
            }
            else
            {
                formModel.Id = editingId.Value;
                await SubjectService.UpdateAsync(formModel);
            }

            subjects = await SubjectService.GetAllAsync();
            showForm = false;
            errorMessage = null;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleDelete(int id)
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsInRole("Admin"))
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Удалить этот предмет?");
        if (!confirmed)
        {
            return;
        }

        await SubjectService.DeleteAsync(id);
        subjects = await SubjectService.GetAllAsync();
    }
}