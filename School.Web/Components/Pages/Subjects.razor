@page "/subjects"
@attribute [Authorize]
@inject ISubjectService SubjectService
@inject AdminGuard AdminGuard

<div class="page-header">
    <h1>Предметы</h1>
</div>

<div class="toolbar">
    @if (!showForm)
    {
        <button class="btn-primary" @onclick="ShowAddForm">Добавить предмет</button>
    }
</div>

@if (!string.IsNullOrEmpty(pageMessage))
{
    <p class="form-error">@pageMessage</p>
}

@if (showForm)
{
    <EntityFormCard TItem="Subject"
                     Title="@(editingId == null ? "Новый предмет" : "Редактирование предмета")"
                     Model="formModel"
                     OnSave="HandleSave"
                     OnCancel="CancelForm"
                     ErrorMessage="@errorMessage"
                     FormName="SubjectForm">
        <div class="form-group">
            <label>Название предмета</label>
            <InputText @bind-Value="formModel.Name" placeholder="Например, Математика" />
        </div>
    </EntityFormCard>
}

@if (subjects == null)
{
    <p class="muted">Загрузка...</p>
}
else if (subjects.Count == 0)
{
    <div class="empty-state">Предметов пока нет.</div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subject in subjects)
                {
                    <tr>
                        <td>@subject.Name</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-link-action" @onclick="() => ShowEditForm(subject)">Изменить</button>
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <button class="btn-link-action danger" @onclick="() => HandleDelete(subject.Id)">Удалить</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const string NotFoundMessage = "Запись не найдена: возможно, её уже удалил другой пользователь. Список обновлён.";

    private List<Subject>? subjects;
    private Subject formModel = new();
    private int? editingId;
    private bool showForm = false;
    private string? errorMessage;
    private string? pageMessage;

    protected override async Task OnInitializedAsync()
    {
        subjects = await SubjectService.GetAllAsync();
    }

    private void ShowAddForm()
    {
        formModel = new();
        editingId = null;
        showForm = true;
        errorMessage = null;
        pageMessage = null;
    }

    private void ShowEditForm(Subject subject)
    {
        formModel = new Subject { Id = subject.Id, Name = subject.Name };
        editingId = subject.Id;
        showForm = true;
        errorMessage = null;
        pageMessage = null;
    }

    private void CancelForm()
    {
        showForm = false;
        errorMessage = null;
    }

    private async Task HandleSave()
    {
        try
        {
            var saved = true;

            if (editingId == null)
            {
                await SubjectService.AddAsync(formModel);
            }
            else
            {
                formModel.Id = editingId.Value;
                saved = await SubjectService.UpdateAsync(formModel);
            }

            subjects = await SubjectService.GetAllAsync();
            showForm = false;
            errorMessage = null;
            pageMessage = saved ? null : NotFoundMessage;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = "Что-то пошло не так, попробуйте ещё раз.";
        }
    }

    private async Task HandleDelete(int id)
    {
        pageMessage = null;

        var result = await AdminGuard.ConfirmAdminActionAsync("Удалить этот предмет?");
        if (result == null)
        {
            pageMessage = "У вас нет прав для удаления.";
            return;
        }
        if (result != true)
        {
            return;
        }

        try
        {
            var deleted = await SubjectService.DeleteAsync(id);
            subjects = await SubjectService.GetAllAsync();
            if (!deleted)
            {
                pageMessage = NotFoundMessage;
            }
        }
        catch (ArgumentException ex)
        {
            pageMessage = ex.Message;
        }
        catch (Exception)
        {
            pageMessage = "Что-то пошло не так, попробуйте ещё раз.";
        }
    }
}