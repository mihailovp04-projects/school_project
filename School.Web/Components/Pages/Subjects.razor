@page "/subjects"
@attribute [Authorize]
@inherits CrudPage<Subject>
@inject ISubjectService SubjectService

<div class="page-header">
    <h1>Предметы</h1>
</div>

<div class="toolbar">
    @if (!IsFormVisible)
    {
        <button class="btn-primary" @onclick="ShowAddForm">Добавить предмет</button>
    }
</div>

@if (!string.IsNullOrEmpty(PageMessage))
{
    <p class="form-error">@PageMessage</p>
}

@if (IsFormVisible)
{
    <EntityFormCard TItem="Subject"
                    Title="@(EditingId == null ? "Новый предмет" : "Редактирование предмета")"
                    Model="FormModel"
                    OnSave="HandleSave"
                    OnCancel="CloseForm"
                    ErrorMessage="@FormError"
                    FormName="SubjectForm">
        <div class="form-group">
            <label>Название предмета</label>
            <InputText @bind-Value="FormModel.Name" placeholder="Например, Математика" />
        </div>
    </EntityFormCard>
}

@if (subjects == null)
{
    <p class="muted">Загрузка...</p>
}
else if (subjects.Count == 0)
{
    <div class="empty-state">Предметов пока нет.</div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subject in subjects)
                {
                    <tr>
                        <td>@subject.Name</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-link-action" @onclick="() => ShowEditForm(subject)">Изменить</button>
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <button class="btn-link-action danger" @onclick="() => HandleDelete(subject.Id)">Удалить</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Subject>? subjects;

    protected override async Task OnInitializedAsync()
    {
        await ReloadSubjectsAsync();
    }

    private async Task ReloadSubjectsAsync()
    {
        subjects = await SubjectService.GetAllAsync();
    }

    private void ShowAddForm()
    {
        OpenForm(new Subject(), null);
    }

    private void ShowEditForm(Subject subject)
    {
        OpenForm(new Subject { Id = subject.Id, Name = subject.Name }, subject.Id);
    }

    private Task HandleSave()
    {
        return SaveFormAsync(EditingId == null ? "AddSubject" : "UpdateSubject", SaveSubjectAsync, ReloadSubjectsAsync);
    }

    private async Task<bool> SaveSubjectAsync()
    {
        if (EditingId == null)
        {
            await SubjectService.AddAsync(FormModel);
            return true;
        }

        return await SubjectService.UpdateAsync(FormModel);
    }

    private Task HandleDelete(int id)
    {
        return RunAdminActionAsync("Удалить этот предмет?", "DeleteSubject", id, () => SubjectService.DeleteAsync(id), ReloadSubjectsAsync);
    }
}
